# 本地密钥与端点配置：复制成 .env 后填写，.env 已被 git 忽略
# Dataset: Ark / Seedream
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=xxxx
SEEDREAM_SIZE=2K

# 可选：企业代理（Ark 是国内站，通常留空）
FIGHTER_PROXY=

# OpenAI 兼容端点（用 GPT-Image-2 时填）
# FIGHTER_API_KEY=
# FIGHTER_BASE_URL=https://api.openai.com
# FIGHTER_MODEL=gpt-image-2
# FIGHTER_QUALITY=medium


# Zhipu BigModel (CogView) text-to-image. Set FIGHTER_PROVIDER=zhipu to use it.
# CogView cannot take a reference photo, so characters drift more than Seedream.
# ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=cogview-4-250304
# ZHIPU_SIZE=1440x720
