# Keep line endings stable across Windows (local) and the Linux deploy server.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.gd text eol=lf
*.json text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png binary
*.webp binary
*.wav binary
*.ogg binary
