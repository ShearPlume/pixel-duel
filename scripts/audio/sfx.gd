extends Node
## Single place for the game's sound effects.
##
## Files live in art/audio and are generated by tools/audio/gen_sfx.py. Three
## rules keep a five player brawl from turning into noise:
##   * per-sound throttling (`gap`) and a voice cap per sound,
##   * a fixed voice pool, so the mixer never runs more than a dozen streams,
##   * world placement: volume falls off with distance from the camera and the
##     pan follows the screen, exactly like an AudioStreamPlayer2D should.

const BANK := {
	"jump": {"db": -14.0, "gap": 60, "voices": 3, "pitch": 0.06},
	"jump_double": {"db": -15.0, "gap": 70, "voices": 2, "pitch": 0.06},
	"land": {"db": -17.0, "gap": 70, "voices": 2, "pitch": 0.08},
	"hit_light": {"db": -10.0, "gap": 45, "voices": 3, "pitch": 0.07},
	"hit_heavy": {"db": -7.0, "gap": 70, "voices": 2, "pitch": 0.05},
	"guitar_swing": {"db": -13.0, "gap": 60, "voices": 2, "pitch": 0.05},
	"guitar_hit": {"db": -8.0, "gap": 70, "voices": 2, "pitch": 0.04},
	"pistol": {"db": -14.0, "gap": 50, "voices": 3, "pitch": 0.08},
	"bubble_fire": {"db": -16.0, "gap": 80, "voices": 2, "pitch": 0.07},
	"bubble_pop": {"db": -13.0, "gap": 60, "voices": 3, "pitch": 0.09},
	"cake_throw": {"db": -16.0, "gap": 90, "voices": 2, "pitch": 0.06},
	"explosion": {"db": -5.0, "gap": 120, "voices": 2, "pitch": 0.05},
	"pickup": {"db": -17.0, "gap": 90, "voices": 2, "pitch": 0.04},
	"heart": {"db": -12.0, "gap": 120, "voices": 1, "pitch": 0.03},
	"ko": {"db": -6.0, "gap": 150, "voices": 2, "pitch": 0.04},
	"respawn": {"db": -14.0, "gap": 150, "voices": 2, "pitch": 0.03},
	"select_move": {"db": -20.0, "gap": 40, "voices": 2, "pitch": 0.05},
	"select_confirm": {"db": -14.0, "gap": 80, "voices": 2, "pitch": 0.02},
}

const DIR := "res://art/audio/"
const WORLD_POOL := 12
const FLAT_POOL := 4

var _streams := {}
var _last := {}
var _world: Array = []
var _flat: Array = []
var _world_index := 0
var _flat_index := 0


func _ready() -> void:
	for key: String in BANK:
		var path := DIR + key + ".wav"
		if ResourceLoader.exists(path):
			_streams[key] = load(path)
	# Flat players, attenuating by hand: the match runs inside a SubViewport on
	# phones, where positional audio has no listener and would be silent.
	for index in range(WORLD_POOL):
		var player := AudioStreamPlayer.new()
		add_child(player)
		_world.append(player)
	for index in range(FLAT_POOL):
		var player := AudioStreamPlayer.new()
		add_child(player)
		_flat.append(player)


func available(key: String) -> bool:
	return _streams.has(key)


## Sound at a world position: panned and attenuated by the camera.
func play(key: String, at: Vector2) -> void:
	var entry: Dictionary = BANK.get(key, {})
	if entry.is_empty() or not _throttle(key, entry):
		return
	var player := _take(_world, "world")
	var gain := 1.0
	var camera := get_viewport().get_camera_2d()
	if camera != null:
		var distance := camera.global_position.distance_to(at)
		gain = clampf(1.0 - distance / 900.0, 0.0, 1.0)
	if gain <= 0.02:
		return
	_start(player, key, entry)
	player.volume_db += linear_to_db(gain) * 0.6


## Sound with no position, for menus.
func play_ui(key: String) -> void:
	var entry: Dictionary = BANK.get(key, {})
	if entry.is_empty() or not _throttle(key, entry):
		return
	_start(_take(_flat, "flat"), key, entry)


func _throttle(key: String, entry: Dictionary) -> bool:
	if not _streams.has(key):
		return false
	var now := Time.get_ticks_msec()
	if now - int(_last.get(key, -10000)) < int(entry.get("gap", 40)):
		return false
	var active := 0
	for player: Node in _world + _flat:
		if player.get_meta("key", "") == key and (player as Node).get("playing"):
			active += 1
	if active >= int(entry.get("voices", 2)):
		return false
	_last[key] = now
	return true


func _take(pool: Array, kind: String) -> Node:
	for player: Node in pool:
		if not bool(player.get("playing")):
			return player
	# Everything is busy: steal in round robin so the newest sound still plays.
	if kind == "world":
		var index := _world_index % pool.size()
		_world_index += 1
		return pool[index]
	var flat_index := _flat_index % pool.size()
	_flat_index += 1
	return pool[flat_index]


func _start(player: Node, key: String, entry: Dictionary) -> void:
	var pitch := float(entry.get("pitch", 0.05))
	player.set_meta("key", key)
	player.stream = _streams[key]
	player.volume_db = float(entry.get("db", -14.0)) + randf_range(-1.5, 1.0)
	player.pitch_scale = randf_range(1.0 - pitch, 1.0 + pitch)
	player.play()


